{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCurated",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::BUCKET/curated/*"
    },
    {
      "Sid": "ListCurated",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET",
      "Condition": { "StringLike": { "s3:prefix": ["curated/*", "curated"] } }
    }
  ]
}
